<Project>
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!-- 07 Q2: libraries must not block, sleep, spawn raw threads or write to the console. App.*
       composition roots and the test project are exempt (they are the top of the call stack). -->
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'UltrasoundHost.Tests' and !$(MSBuildProjectName.StartsWith('UltrasoundHost.App.'))">
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="All" />
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" PrivateAssets="All" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" />
  </ItemGroup>
</Project>

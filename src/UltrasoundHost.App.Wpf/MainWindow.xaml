<Window x:Class="UltrasoundHost.App.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="超声检测上位机"
        Width="1320"
        Height="840"
        MinWidth="960"
        MinHeight="600"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <TextBlock Text="通道数" VerticalAlignment="Center" Margin="4,0" />
                <TextBox x:Name="ChannelsBox" Width="52" Text="2" VerticalContentAlignment="Center" />
                <Button x:Name="OpenButton" Content="打开模拟板卡" Click="Open_Click" Margin="6,0,0,0" />
                <Separator />
                <Button x:Name="StartButton" Content="开始采集" Click="Start_Click" IsEnabled="False" />
                <Button x:Name="StopButton" Content="停止采集" Click="Stop_Click" IsEnabled="False" />
                <Separator />
                <TextBlock Text="增益 (dB)" VerticalAlignment="Center" Margin="4,0" />
                <TextBox x:Name="GainBox" Width="44" Text="0" VerticalContentAlignment="Center" />
                <Button x:Name="ApplyButton" Content="应用参数" Click="Apply_Click" IsEnabled="False" />
                <Separator />
                <TextBlock Text="显示通道" VerticalAlignment="Center" Margin="4,0" />
                <ComboBox x:Name="ChannelBox" Width="64" SelectionChanged="Channel_Changed" />
            </ToolBar>
        </ToolBarTray>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="正在启动…" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock x:Name="FrameText" />
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="440" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <GroupBox Grid.Row="0" Header="插件" Margin="0,0,0,8">
                    <ListView x:Name="PluginList">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="名称" Width="110" DisplayMemberBinding="{Binding Name}" />
                                <GridViewColumn Header="插件 Id" Width="130" DisplayMemberBinding="{Binding Id}" />
                                <GridViewColumn Header="类型" Width="60" DisplayMemberBinding="{Binding Kind}" />
                                <GridViewColumn Header="状态" Width="70" DisplayMemberBinding="{Binding State}" />
                                <GridViewColumn Header="原因" Width="200" DisplayMemberBinding="{Binding Reason}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </GroupBox>

                <GroupBox Grid.Row="1" Header="会话检查">
                    <ListView x:Name="SessionList">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="插件" Width="150" DisplayMemberBinding="{Binding Plugin}" />
                                <GridViewColumn Header="结果" Width="70" DisplayMemberBinding="{Binding Verdict}" />
                                <GridViewColumn Header="详情" Width="300" DisplayMemberBinding="{Binding Details}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </GroupBox>
            </Grid>

            <TabControl x:Name="ViewTabs" Grid.Column="1" Margin="4,8,8,8" />
        </Grid>
    </DockPanel>
</Window>
